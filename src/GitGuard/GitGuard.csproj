<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GitGuard</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageOutputPath>../../release</PackageOutputPath>
    <PackAsTool>true</PackAsTool>
  </PropertyGroup>

  <PropertyGroup>
    <ToolCommandName>git-guard</ToolCommandName>
    <PackageId>grdev.git-guard-cli</PackageId>
    <Title>Greek Developer - Git Guard CLI</Title>
    <Description>Git Repositories Management CLI</Description>
	<Authors>Thomas Sarmis (thomas.sarmis@gmail.com), GRDEV</Authors>
    <RepositoryUrl>https://github.com/greek-developer/git-guard-cli</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://greekdeveloper.com/projects/gitguard</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.1" />
  </ItemGroup>

   <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>        
  </ItemGroup>

</Project>
